<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#050c1c">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>Sharanagati Counter</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;user-select:none;-webkit-user-select:none;}

html,body{height:100%;overflow:hidden;}

body{
  background:radial-gradient(circle at 50% 30%,#122a4d 0%,#0a1830 45%,#050c1c 100%);
  color:#fff;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
  cursor:pointer;
}

#app{
  position:fixed;
  inset:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
}

.controls{
  position:absolute;
  top:calc(22px + env(safe-area-inset-top));
  right:22px;
  display:flex;
  gap:12px;
  z-index:100;
}

.btn{
  width:44px;height:44px;
  display:flex;justify-content:center;align-items:center;
  border:1px solid rgba(212,175,55,.35);
  border-radius:50%;
  font-size:18px;color:#fff;
  background:rgba(212,175,55,.08);
  cursor:pointer;opacity:.7;
  transition:.2s;
}
.btn:hover{opacity:1;background:rgba(212,175,55,.18);}

.namaste{font-size:58px;}

h1{
  color:#D4AF37;
  letter-spacing:8px;
  font-size:18px;
  font-weight:500;
  margin-top:12px;
}

#count{
  font-size:min(32vw,190px);
  font-weight:700;
  margin-top:18px;
  line-height:1;
  text-shadow:0 0 40px rgba(212,175,55,.25);
  transition:transform .08s;
}
.pulse{transform:scale(1.08);}

.label{opacity:.65;margin-top:6px;font-size:16px;letter-spacing:1px;}

.beadBox{margin-top:30px;font-size:22px;line-height:1.5;}
.gold{color:#D4AF37;}

.progress{
  width:min(280px,70vw);
  height:8px;
  background:rgba(255,255,255,.08);
  border-radius:50px;
  margin:18px auto 0;
  overflow:hidden;
}
.progressFill{
  height:100%;width:0%;
  background:linear-gradient(90deg,#D4AF37,#F5D77A);
  box-shadow:0 0 12px rgba(212,175,55,.5);
  transition:.2s;
}

#malas{margin-top:22px;font-size:16px;opacity:.6;letter-spacing:1px;}

#hint{
  position:absolute;
  bottom:calc(28px + env(safe-area-inset-bottom));
  left:0;right:0;
  opacity:.4;font-size:14px;letter-spacing:.5px;
}

#plusOne{
  position:absolute;
  left:50%;top:44%;
  transform:translateX(-50%);
  font-size:44px;color:#D4AF37;
  opacity:0;pointer-events:none;
}
.float{animation:float .8s ease-out;}
@keyframes float{
  0%{transform:translateX(-50%) translateY(0);opacity:1;}
  100%{transform:translateX(-50%) translateY(-120px);opacity:0;}
}

#lotus{
  position:fixed;inset:0;
  display:flex;justify-content:center;align-items:center;flex-direction:column;
  background:radial-gradient(circle at 50% 40%,rgba(18,42,77,.97),rgba(5,12,28,.98));
  opacity:0;pointer-events:none;transition:.5s;
}
#lotus.show{opacity:1;}
#flower{font-size:110px;}
#lotus h2{margin-top:20px;color:#D4AF37;font-size:34px;letter-spacing:3px;}
#lotus p{margin-top:10px;font-size:22px;opacity:.9;}
@keyframes bloom{
  0%{transform:scale(.2) rotate(-30deg);}
  100%{transform:scale(1);}
}
.bloom{animation:bloom .8s ease;}
</style>
</head>
<body>

<div id="app">

  <div class="controls">
    <div class="btn" id="undo">&#8630;</div>
    <div class="btn" id="reset">&#8634;</div>
  </div>

  <div class="namaste">&#128591;</div>
  <h1>SHARANAGATI</h1>

  <div id="count">0</div>
  <div class="label">Current Chant</div>

  <div class="beadBox">
    Bead<br>
    <span class="gold" id="bead">0</span><br>
    / 108
  </div>

  <div class="progress"><div class="progressFill" id="fill"></div></div>

  <div id="malas">Malas Completed: <span class="gold" id="malaCount">0</span></div>

  <div id="hint">Tap Anywhere &#8226; SPACE &#8226; ENTER &#8226; &#8593;</div>
  <div id="plusOne">+1</div>

</div>

<div id="lotus">
  <div id="flower">&#127800;</div>
  <h2>MALA COMPLETE</h2>
  <p>You completed one Mala.</p>
</div>

<script>
(function(){
  var chants = Number(localStorage.getItem("sh_chants")) || 0;

  var countEl = document.getElementById("count");
  var beadEl  = document.getElementById("bead");
  var fillEl  = document.getElementById("fill");
  var malaEl  = document.getElementById("malaCount");
  var plusEl  = document.getElementById("plusOne");
  var lotusEl = document.getElementById("lotus");
  var flowerEl= document.getElementById("flower");

  function update(){
    countEl.innerText = chants;
    beadEl.innerText  = chants % 108;
    malaEl.innerText  = Math.floor(chants / 108);
    fillEl.style.width = ((chants % 108) / 108 * 100) + "%";
    try{ localStorage.setItem("sh_chants", chants); }catch(e){}
  }

  function add(){
    chants++;

    countEl.classList.add("pulse");
    setTimeout(function(){ countEl.classList.remove("pulse"); }, 80);

    plusEl.classList.remove("float");
    void plusEl.offsetWidth;
    plusEl.classList.add("float");

    if(navigator.vibrate){ navigator.vibrate(12); }

    if(chants > 0 && chants % 108 === 0){
      lotusEl.classList.add("show");
      flowerEl.classList.remove("bloom");
      void flowerEl.offsetWidth;
      flowerEl.classList.add("bloom");
      setTimeout(function(){ lotusEl.classList.remove("show"); }, 2200);
    }

    update();
  }

  function undo(){
    if(chants === 0) return;
    chants--;
    if(navigator.vibrate){ navigator.vibrate(8); }
    update();
  }

  document.body.addEventListener("click", function(e){
    if(e.target.id === "reset" || e.target.id === "undo") return;
    add();
  });

  document.addEventListener("keydown", function(e){
    if(e.code === "Space" || e.code === "ArrowUp" || e.code === "Enter"){
      e.preventDefault();
      add();
    }
  });

  document.getElementById("undo").addEventListener("click", function(e){
    e.stopPropagation();
    undo();
  });

  document.getElementById("reset").addEventListener("click", function(e){
    e.stopPropagation();
    if(confirm("Reset chant counter?")){
      chants = 0;
      update();
    }
  });

  // Keep screen awake
  var wakeLock = null;
  async function requestWake(){
    try{
      if("wakeLock" in navigator){
        wakeLock = await navigator.wakeLock.request("screen");
      }
    }catch(e){}
  }
  requestWake();
  document.addEventListener("visibilitychange", function(){
    if(document.visibilityState === "visible"){ requestWake(); }
  });

  update();
})();
</script>
</body>
</html>
